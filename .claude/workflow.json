{
  "projectRulesFile": "CLAUDE.md",
  "architectureFile": "docs/architecture/ARCHITECTURE.md",
  "progressDir": ".claude/progress",
  "branching": {
    "baseBranch": "auto",
    "featurePrefix": "feature",
    "workPrefix": "work",
    "enforce": "warn",
    "protectedBranches": ["main", "master"],
    "useWorktrees": false,
    "worktreeDir": ".worktrees"
  },
  "worktreeBootstrap": {
    "script": "scripts/generate-worktree-claude.mjs",
    "includeSections": [
      "verification-requirements",
      "v2-refactor-context",
      "eslint-rules",
      "import-order",
      "design-system",
      "ipc-contract",
      "service-pattern",
      "feature-module-pattern"
    ],
    "alwaysIncludeDocs": [
      "docs/patterns/CODEBASE-GUARDIAN.md",
      "docs/patterns/LINTING.md",
      "docs/patterns/PATTERNS.md"
    ]
  }
}
